{
  "name": "Freenove FNK0104B (ESP32-S3, 16 MB flash, 8 MB OPI PSRAM)",
  "vendor": "Freenove",
  "url": "https://github.com/Freenove/Freenove_ESP32_S3_Display",
  "frameworks": ["arduino"],
  "build": {
    "core": "esp32",
    "mcu": "esp32s3",
    "variant": "esp32s3",
    "f_cpu": "240000000L",
    "f_flash": "80000000L",
    "flash_mode": "qio",
    "arduino": {
      "ldscript": "esp32s3_out.ld",
      "partitions": "default_16MB.csv",
      "memory_type": "qio_opi"
    },
    "extra_flags": [
      "-DARDUINO_ESP32S3_DEV",
      "-DARDUINO_RUNNING_CORE=1",
      "-DARDUINO_EVENT_RUNNING_CORE=1"
    ],
    "hwids": [["0x303A", "0x1001"]]
  },
  "upload": {
    "flash_size": "16MB",
    "maximum_ram_size": 327680,
    "maximum_size": 16777216,
    "require_upload_port": true,
    "speed": 460800
  }
}
